# LLM (ingest evidence screening, clustering, agent prompt generation)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Admin API stopgap — no user/role auth system exists yet, so admin routes
# check this single shared bearer token. Replace with real admin auth once
# a user/auth system exists (see lib/idea-drops/require-admin.ts).
ADMIN_API_TOKEN=

# Razorpay — checkout redirect + subscription webhook
RAZORPAY_WEBHOOK_SECRET=
BUILDER_PAYMENT_LINK=https://rzp.io/l/xxxxxxx
STUDIO_PAYMENT_LINK=https://rzp.io/l/xxxxxxx
RAZORPAY_BUILDER_PLAN_ID=
RAZORPAY_STUDIO_PLAN_ID=

# Days a past_due subscriber keeps paid-tier access before downgrading to free
SUBSCRIPTION_GRACE_DAYS=3
