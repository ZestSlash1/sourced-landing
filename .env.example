# Supabase project URL and keys (Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=
# Anon/public key — safe to ship to the browser. Required for admin sign-in
# (lib/supabase/browser.ts, lib/supabase/auth-server.ts).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — server-only, bypasses RLS. Never prefix with
# NEXT_PUBLIC_ or ship to the client bundle (lib/supabase/server.ts).
SUPABASE_SERVICE_ROLE_KEY=

# GitHub/Google/Apple sign-in (app/login) are Supabase Auth OAuth providers —
# configured in the Supabase dashboard (Authentication -> Providers) with
# each provider's own client id/secret, not env vars in this app.

# OpenRouter — now a fallback-only dependency for both classification and
# draft generation (omniroute-drafts-and-ollama-lockin-spec.md). The pipeline
# runs day-to-day on Ollama + OmniRoute below and never touches OpenRouter
# when both of those are reachable, so this key can sit at $0 balance
# indefinitely under normal operation. It's still required as a configured
# fallback though — get a key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=
# Optional override; defaults to meta-llama/llama-3.3-70b-instruct:free.
OPENROUTER_DRAFT_MODEL=
# Optional override for the complaint-classification stage (lib/ingest/
# classification.ts); defaults to google/gemini-3.5-flash-lite.
OPENROUTER_CLASSIFY_MODEL=

# Local classification via Ollama (ollama-classification-spec.md) — set only
# on falcon (or any machine on the same LAN running Ollama). When set,
# lib/llm/classifier.ts routes every classification call to Ollama first and
# falls back to OpenRouter on failure. Leave BOTH unset in Vercel production
# env so cron always uses OpenRouter.
OLLAMA_URL=
# Optional override; defaults to qwen2.5:7b-instruct.
OLLAMA_CLASSIFIER_MODEL=

# Local draft generation via OmniRoute (omniroute-drafts-and-ollama-lockin-
# spec.md) — a self-hosted AI gateway on falcon. Set only on falcon (or any
# machine on the same LAN running OmniRoute). When set,
# lib/llm/draft-generator.ts routes every draft-generation call to OmniRoute
# first and falls back to OpenRouter on failure. Leave unset in Vercel
# production env so cron always uses OpenRouter — OmniRoute is only reachable
# on the local network.
OMNIROUTE_URL=
# Optional override; defaults to "auto" (OmniRoute's own model router —
# currently resolves to gemini-3.1-pro).
OMNIROUTE_DRAFT_MODEL=

# Competitive gap check (lib/ingest/competitive-landscape.ts) — one real
# OpenRouter `:online` web-search call per drafted cluster, so "does this
# already exist" is grounded in an actual search, never the model's memory.
# Uses the same OPENROUTER_API_KEY above. Optional override; the ":online"
# suffix is appended automatically, don't include it here.
OPENROUTER_COMPETITIVE_MODEL=

# Reddit poller (Phase 4 Part A1) — create a "script" app at
# https://www.reddit.com/prefs/apps, then use its client id/secret here.
# Without these the Reddit poller no-ops (returns no signals); HN, Stack
# Exchange, and GitHub Issues all work without any of these three.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# YouTube comments poller (poller-expansion-spec.md Source 1) — free API key
# from Google Cloud Console with the YouTube Data API v3 enabled. Without it
# the YouTube poller no-ops (returns no signals), same convention as Reddit
# above. Codeberg, Discourse, and Mastodon pollers need no keys at all.
YOUTUBE_API_KEY=

# GitHub Issues poller — optional, raises the unauthenticated 60 req/hr
# GitHub API limit. A classic PAT with no scopes is enough (public read only).
GITHUB_TOKEN=

# Shared secret Vercel Cron sends as `Authorization: Bearer $CRON_SECRET` on
# every /api/cron/* request — set the same value in the Vercel project's env
# vars. Any request without a matching header is rejected.
CRON_SECRET=

# Razorpay — Dashboard -> Settings -> API keys. Use a dedicated Razorpay
# account for this app, not one shared with another product on the same
# business — a shared account's webhook fires for every product's payment
# events, not just this app's.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Same value as RAZORPAY_KEY_ID — needed client-side to open Razorpay Checkout.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Plan IDs from Dashboard -> Payments -> Plans (or created via the Plans API).
RAZORPAY_PLAN_BUILDER_MONTHLY=
RAZORPAY_PLAN_BUILDER_YEARLY=
# ₹310/mo founding-rate Builder plan — a separate Razorpay plan_id (not the
# same one discounted) so the price is locked into the subscription itself.
# Gated to the first 100 ever-paid subscribers by lib/subscriptions/founding.ts.
RAZORPAY_PLAN_BUILDER_FOUNDING=
RAZORPAY_PLAN_STUDIO_MONTHLY=

# Dashboard -> Account & Settings -> Webhooks -> Add New Webhook, pointed at
# <your-domain>/api/webhooks/razorpay with the "Subscription Events" group
# selected. Whatever secret you set there goes here too — the webhook route
# verifies every request's signature against it before trusting the payload.
RAZORPAY_WEBHOOK_SECRET=

# Phone push notifications on signup/payment (lib/notify.ts) via ntfy.sh —
# pick a private, hard-to-guess topic name (e.g. a random slug, not
# "sourced-alerts"), then subscribe to it in the ntfy app (iOS/Android).
# Anyone who knows the topic name can read it and publish to it, since ntfy.sh
# topics aren't authenticated by default — treat the topic name like a secret.
# Leave unset to disable notifications entirely.
NTFY_TOPIC=
# Optional: point at a self-hosted ntfy server instead of ntfy.sh.
NTFY_URL=

# Analytics own-traffic exclusion (lib/analytics/exclusion.ts). Comma-separated
# IPs whose visits are never recorded — covers every browser on a machine at
# once, but a home IP is usually dynamic, so it goes stale. The reliable
# per-browser switch is visiting /api/track/opt-out once; this is the
# belt-and-braces companion to it. Leave unset to exclude nothing by IP.
ANALYTICS_EXCLUDED_IPS=
